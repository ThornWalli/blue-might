:root {
  --font-base: 'Open Sans', sans-serif;

  --color-white: #FFFFFF;
  --rgb-white: 255 255 255;
  --color-black: #000000;
  --rgb-black: 0 0 0;


  --color-background-primary: #ffffff;
  --rgb-color-background-primary: 255 255 255;
  --color-background-secondary: #1e1e1e;
  --rgb-color-background-secondary: 30 30 30;


  /* white */




  /* blue  */
  --color-blue-0: #edf8ff;
  --color-blue-1: #d6efff;
  --color-blue-2: #b5e4ff;
  --color-blue-3: #83d5ff;
  --color-blue-4: #48bcff;
  --color-blue-5: #1e9aff;
  --color-blue-6: #067aff;
  --color-blue-7: #0066ff;
  --rgb-blue-7: 0 102 255;
  --color-blue-8: #084ec5;
  --color-blue-9: #0d469b;
  --color-blue-10: #0e2b5d;

  /* red */
  --color-red-0: #fff0f0;
  --color-red-1: #ffdddd;
  --color-red-2: #ffc0c0;
  --color-red-3: #ff9494;
  --color-red-4: #ff5757;
  --color-red-5: #ff2323;
  --color-red-6: #ff0000;
  --color-red-7: #d70000;
  --color-red-8: #b10303;
  --color-red-9: #920a0a;
  --color-red-10: #500000;

  /* grreen */
  --color-green-0: #f0fff4;
  --color-green-1: #dcffe4;
  --color-green-2: #b7ffc9;
  --color-green-3: #7afc9c;
  --color-green-4: #3ef66e;
  --color-green-5: #17e34a;
  --color-green-6: #00c32c;
  --color-green-7: #009925;
  --color-green-8: #007a1d;
  --color-green-9: #005d16;
  --color-green-10: #002d0a;

  /* yellow */
  --color-yellow-0: #fffbeb;
  --color-yellow-1: #fef3c7;
  --color-yellow-2: #fde68a;
  --color-yellow-3: #fcd34d;
  --color-yellow-4: #fbbf24;
  --color-yellow-5: #f59e0b;
  --color-yellow-6: #d97706;
  --color-yellow-7: #b45309;
  --color-yellow-8: #92400e;
  --color-yellow-9: #78350f;
  --color-yellow-10: #451a03;

  --color-mono-0: #ffffff;
  --color-mono-1: #f7f7f7;
  --color-mono-2: #e1e1e1;
  --color-mono-3: #cfcfcf;
  --color-mono-4: #b1b1b1;
  --color-mono-5: #9e9e9e;
  --color-mono-6: #7e7e7e;
  --color-mono-7: #626262;
  --color-mono-8: #515151;
  --color-mono-9: #3b3b3b;
  --color-mono-10: #222222;

  /* blur */
  --bm-blur-default: 4px;

/* padding margin gap */
--bm-spacing-small: 4px;
--bm-spacing-medium: 8px;
--bm-spacing-large: 16px;
--bm-spacing-very-large: 32px;

/* border radius */

--bm-border-radius-small: 3px;
--bm-border-radius-medium: 6px;
--bm-border-radius-large: 9px;
--bm-border-radius-very-large: 12px;

/* font sizes */
--bm-font-size-small: 12px;
--bm-font-size-medium: 14px;
--bm-font-size-large: 16px;
--bm-font-size-very-large: 20px;


/* easings */

--bm-easing-duration-very-short: 0.125s;
--bm-easing-duration-short: 0.25s;
--bm-easing-duration-moderate: 0.4s;
--bm-easing-duration-long: 0.6s;
--bm-easing-duration-very-long: 1.2s;
--bm-easing-base: cubic-bezier(0.25, 0.1, 0.25, 1);
--bm-easing-in: cubic-bezier(0, 0, 0.2, 1);
--bm-easing-out: cubic-bezier(0.4, 0, 0.5, 1);


/* overlay */
--bm-overlay-background: #000;
--bm-overlay-backdrop-blur: var(--bm-blur-default);
--bm-overlay-border-radius: 0;
--bm-overlay-box-shadow: 0 0 2px 1px  rgb(0 0 0 / 80%);


--bm-panel-offset: var(--bm-spacing-medium);
--bm-panel-gap: 8px;

  /* Originalfarben */
  --color-green-dark: #205010FF;
  --color-green-soft: #A0B0A0FF;
  --color-white: #FFFFFFFF;
  --color-blue: #0055AAFF;
  --color-blue-soft: #e0eafb;
  --color-gray-dark: #303030FF;
  --color-black: #000000FF;

  /* Erweiterte Grüntöne & Erdtöne */
  --color-green-mid: #4A7A38FF;
  --color-green-muted: #789878FF;
  --color-earth: #8C6F4AFF;
  --color-wood: #7D5B3AFF;

  /* Erweiterte Blautöne */
  --color-blue-light: #1A75CFFF;
  --color-blue-dark: #003B7AFF;
  --color-blue-soft: #66A7E7FF;

  /* Neutrale Töne */
  --color-gray-light: #F2F2F2FF;
  --color-gray-mid: #808080FF;
  --color-gray-very-dark: #1A1A1AFF;

  /* Akzentfarben */
  --color-gold: #D8A040FF;
  --color-terra: #CC5533FF;
  --color-beige: #E0D8A8FF;

  --color-skin: #F0C8A0FF;



  /* misc */
  --color-gdi-primary: #D4AF37;
  --color-gdi-secondary: #4A4F55;
  --color-gdi-tertiary: #8A8F94;

  --color-nod-primary: #8B0000;
  --color-nod-secondary: #4A4F55;
  --color-nod-tertiary: #1A1A1A;

}




