.grid-row {
  display: flex;
  flex-direction: row;
  gap: var(--bm-spacing-small);
  width: 100%;

  &.grid-row-start {
    align-items: flex-start;
  }

  &.grid-row-end {
    justify-content: flex-end;
  }
}

.grid-col {
  display: flex;
  flex-direction: column;
  gap: var(--bm-spacing-small);
  align-items: center;

  &.grid-col-vertical {
    justify-content: center;
  }

  &.grid-col-full {
    flex: 1;
  }

  &.grid-col-start {
    align-items: flex-start;
  }

  &.grid-col-end {
    align-items: flex-end;
  }
}
