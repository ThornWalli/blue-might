.grid-r {
  display: flex;
  flex-direction: row;
  gap: var(--bm-spacing-small);
  width: 100%;

  &.grid-r-start {
    align-items: flex-start;
  }
}

.grid-c {
  display: flex;
  flex-direction: column;
  gap: var(--bm-spacing-small);
  align-items: center;

  &.grid-c-vertical {
    justify-content: center;
  }

  &.grid-c-full {
    flex: 1;
  }

  &.grid-c-end {
    align-items: flex-end;
  }
}
