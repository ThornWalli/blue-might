.fade-short-enter-active,
.fade-short-leave-active {
  transition: opacity var(--bm-easing-duration-short) var(--bm-easing-base);
}

.fade-short-enter-from,
.fade-short-leave-to {
  opacity: 0;
}

.fade-moderate-enter-active,
.fade-moderate-leave-active {
  transition: opacity var(--bm-easing-duration-moderate) var(--bm-easing-base);
}

.fade-moderate-enter-from,
.fade-moderate-leave-to {
  opacity: 0;
}

.fade-long-enter-active,
.fade-long-leave-active {
  transition: opacity var(--bm-easing-duration-long) var(--bm-easing-base);
}

.fade-long-enter-from,
.fade-long-leave-to {
  opacity: 0;
}
